/*
================================================================================
                       SILVER LAYER - TRANSFORM SCRIPT
================================================================================

Project:
--------
Retail Analytics Data Warehouse

Purpose:
--------
Transforms raw Bronze layer data into cleaned, standardized, and validated
Silver layer tables.

Data Flow:
----------
Source CSV → Bronze Layer → Silver Layer → Gold Layer

Silver Layer Responsibilities:
-------------------------------
- Clean and standardize source data
- Remove duplicate records
- Handle invalid and missing values
- Standardize categorical attributes
- Validate dates and numeric values
- Derive required attributes
- Preserve source-to-target traceability

Execution:
----------
Each transformation truncates the corresponding Silver table before loading
the latest transformed data from the Bronze layer.

Data Quality Rules:
-------------------
- Keep the latest CRM customer record for each customer ID.
- Standardize marital status and gender values.
- Convert invalid customer dates to NULL.
- Derive product category IDs from product keys.
- Derive product end dates using the next product start date.
- Validate and recalculate sales and prices when inconsistent.
- Remove known source-system prefixes from customer IDs.
- Convert future birth dates to NULL.
- Standardize gender and country values.
- Remove carriage-return characters introduced by source CSV files.
- Standardize maintenance indicators.

================================================================================
*/


-- ============================================================================
-- SOURCE DATABASE
-- ============================================================================

USE RetailAnalyticsDW_bronze;


-- ============================================================================
-- CRM CUSTOMER DATA
-- ============================================================================
/*
Keeps only the latest record for each customer ID.

Customer attributes are trimmed and categorical values are standardized.
Invalid or incomplete customer creation dates are converted to NULL.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.crm_cust_info;

INSERT INTO RetailAnalyticsDW_silver.crm_cust_info (
    cst_id,
    cst_key,
    cst_firstname,
    cst_lastname,
    cst_marital_status,
    cst_gndr,
    cst_create_date
)
SELECT
    cst_id,
    cst_key,
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname) AS cst_lastname,

    CASE
        WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
        WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
        ELSE 'n/a'
    END AS cst_marital_status,

    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
        WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
        ELSE 'n/a'
    END AS cst_gndr,

    CASE
        WHEN LENGTH(TRIM(REPLACE(cst_create_date, CHAR(13), ''))) != 10
            OR TRIM(cst_create_date) IS NULL
        THEN NULL
        ELSE CAST(cst_create_date AS DATE)
    END AS cst_create_date

FROM (
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY cst_id
            ORDER BY cst_create_date DESC
        ) AS flag_last

    FROM crm_cust_info

    WHERE cst_id IS NOT NULL
) t

WHERE flag_last = 1 AND cst_key LIKE 'AW%';


-- ============================================================================
-- CRM PRODUCT DATA
-- ============================================================================
/*
Extracts the category ID from the product key and standardizes product line
codes into descriptive values.

The product end date is derived from the next available product start date.
One day is subtracted so that product validity periods do not overlap.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.crm_prd_info;

INSERT INTO RetailAnalyticsDW_silver.crm_prd_info (
    prd_id,
    cat_id,
    prd_key,
    prd_nm,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)
SELECT
    prd_id,
    SUBSTRING(TRIM(prd_key), 1, 5) AS cat_id,
    SUBSTRING(TRIM(prd_key), 7) AS prd_key,
    TRIM(prd_nm) AS prd_nm,
    prd_cost,

    CASE UPPER(TRIM(prd_line))
        WHEN 'R' THEN 'Road'
        WHEN 'M' THEN 'Mountain'
        WHEN 'S' THEN 'Other States'
        WHEN 'T' THEN 'Touring'
        ELSE 'n/a'
    END AS prd_line,

    prd_start_dt,

    DATE_SUB(
        LEAD(prd_start_dt) OVER (
            PARTITION BY prd_key
            ORDER BY prd_start_dt
        ),
        INTERVAL 1 DAY
    ) AS prd_end_dt

FROM crm_prd_info;


-- ============================================================================
-- CRM SALES DATA
-- ============================================================================
/*
Validates transaction dates and ensures sales and price values are
mathematically consistent with quantity.

Invalid dates are converted to NULL. Sales and price values are recalculated
when source values are missing, invalid, or inconsistent.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.crm_sales_details;

INSERT INTO RetailAnalyticsDW_silver.crm_sales_details (
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt,
    sls_sales,
    sls_quantity,
    sls_price
)
SELECT
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,

    CASE
        WHEN LENGTH(sls_order_dt) != 8
            OR sls_order_dt = 0
        THEN NULL
        ELSE CAST(sls_order_dt AS DATE)
    END AS sls_order_dt,

    CASE
        WHEN LENGTH(sls_ship_dt) != 8
            OR sls_ship_dt = 0
        THEN NULL
        ELSE CAST(sls_ship_dt AS DATE)
    END AS sls_ship_dt,

    CASE
        WHEN LENGTH(sls_due_dt) != 8
            OR sls_due_dt = 0
        THEN NULL
        ELSE CAST(sls_due_dt AS DATE)
    END AS sls_due_dt,

    CASE
        WHEN ABS(sls_price) * sls_quantity != sls_sales
            OR sls_sales IS NULL
            OR sls_sales <= 0
        THEN ABS(sls_price) * sls_quantity
        ELSE sls_sales
    END AS sls_sales,

    sls_quantity,

    CASE
        WHEN sls_price IS NULL
            OR sls_price <= 0
        THEN sls_sales / NULLIF(sls_quantity, 0)
        ELSE sls_price
    END AS sls_price

FROM crm_sales_details;


-- ============================================================================
-- ERP CUSTOMER DATA
-- ============================================================================
/*
Removes the NAS source-system prefix from customer IDs.

Birth dates occurring in the future are considered invalid and converted
to NULL.

Gender values are standardized after removing carriage-return characters
introduced by the source CSV files.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.erp_cust_az12;

INSERT INTO RetailAnalyticsDW_silver.erp_cust_az12 (
    cid,
    bdate,
    gen
)
SELECT
    CASE
        WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4)
        ELSE cid
    END AS cid,

    CASE
        WHEN bdate > CURRENT_DATE THEN NULL
        ELSE bdate
    END AS bdate,

    CASE
        WHEN UPPER(TRIM(REPLACE(gen, CHAR(13), ''))) IN ('F', 'FEMALE')
            THEN 'Female'
        WHEN UPPER(TRIM(REPLACE(gen, CHAR(13), ''))) IN ('M', 'MALE')
            THEN 'Male'
        ELSE 'n/a'
    END AS gen

FROM erp_cust_az12;


-- ============================================================================
-- ERP LOCATION DATA
-- ============================================================================
/*
Removes separators from customer IDs and standardizes country values.

Known country codes are mapped to descriptive country names. Blank or
missing country values are represented as 'n/a'.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.erp_loc_a101;

INSERT INTO RetailAnalyticsDW_silver.erp_loc_a101 (
    cid,
    cntry
)
SELECT
    REPLACE(cid, '-', '') AS cid,

    CASE
        WHEN TRIM(REPLACE(cntry, CHAR(13), '')) = 'DE'
            THEN 'Germany'

        WHEN TRIM(REPLACE(cntry, CHAR(13), '')) IN ('US', 'USA')
            THEN 'United States'

        WHEN TRIM(REPLACE(cntry, CHAR(13), '')) = ''
            OR TRIM(REPLACE(cntry, CHAR(13), '')) IS NULL
            THEN 'n/a'

        ELSE TRIM(REPLACE(cntry, CHAR(13), ''))
    END AS cntry

FROM erp_loc_a101;


-- ============================================================================
-- ERP CATEGORY DATA
-- ============================================================================
/*
Standardizes maintenance indicators and removes carriage-return characters
from the source values.
*/

TRUNCATE TABLE RetailAnalyticsDW_silver.erp_cat_g1v2;

INSERT INTO RetailAnalyticsDW_silver.erp_cat_g1v2 (
    id,
    cat,
    subcat,
    maintenance
)
SELECT
    id,
    TRIM(cat) AS cat,
    TRIM(subcat) AS subcat,

    CASE
        WHEN UPPER(TRIM(REPLACE(maintenance, CHAR(13), ''))) = 'YES'
            THEN 'Yes'

        WHEN UPPER(TRIM(REPLACE(maintenance, CHAR(13), ''))) = 'NO'
            THEN 'No'

        ELSE 'n/a'
    END AS maintenance

FROM erp_cat_g1v2;
